{
  "entities": {
    "BusinessSettings": {
      "title": "BusinessSettings",
      "description": "Public business identity and contact configuration for Naveen Minerals.",
      "type": "object",
      "properties": {
        "companyName": {
          "type": "string",
          "description": "Official company name",
          "minLength": 2,
          "maxLength": 100
        },
        "tagline": {
          "type": "string",
          "description": "Company tagline",
          "minLength": 2,
          "maxLength": 160
        },
        "address": {
          "type": "string",
          "description": "Complete physical business address",
          "minLength": 5,
          "maxLength": 300
        },
        "email": {
          "type": "string",
          "description": "Official business email address",
          "minLength": 5,
          "maxLength": 120,
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
        },
        "phone": {
          "type": "string",
          "description": "Official business contact phone number",
          "minLength": 8,
          "maxLength": 25,
          "pattern": "^[0-9+\\-\\s()]{8,25}$"
        },
        "introText": {
          "type": "string",
          "description": "Hero and about introductory text",
          "minLength": 10,
          "maxLength": 600
        },
        "aboutText": {
          "type": "string",
          "description": "About page introductory copy",
          "minLength": 10,
          "maxLength": 1200
        },
        "gstin": {
          "type": "string",
          "description": "Optional GSTIN registration number (unset until verified)",
          "maxLength": 20
        },
        "gstinVerified": {
          "type": "boolean",
          "description": "Whether the GSTIN is verified and approved for public display"
        },
        "showGstinPublicly": {
          "type": "boolean",
          "description": "Whether to display the verified GSTIN on the public website"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update"
        },
        "updatedBy": {
          "type": "string",
          "description": "UID of administrator who updated settings",
          "maxLength": 128
        }
      },
      "required": [
        "companyName",
        "tagline",
        "address",
        "email",
        "phone",
        "introText",
        "aboutText",
        "gstinVerified",
        "showGstinPublicly",
        "updatedAt"
      ]
    },
    "Product": {
      "title": "Product",
      "description": "Editable mineral product catalogue record.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique product identifier",
          "minLength": 2,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Display name of the mineral product",
          "minLength": 2,
          "maxLength": 100
        },
        "slug": {
          "type": "string",
          "description": "URL-safe slug for product routing",
          "minLength": 2,
          "maxLength": 80,
          "pattern": "^[a-z0-9\\-]+$"
        },
        "category": {
          "type": "string",
          "description": "Product category classification",
          "enum": ["Mineral Powders", "Crushed Stone & Chips", "Decorative Powder"],
          "maxLength": 50
        },
        "shortDescription": {
          "type": "string",
          "description": "Concise summary shown on product cards",
          "minLength": 10,
          "maxLength": 350
        },
        "fullDescription": {
          "type": "string",
          "description": "Detailed description shown on the product detail page",
          "minLength": 10,
          "maxLength": 2000
        },
        "commonApplications": {
          "type": "array",
          "description": "List of common industrial or decorative applications (bounded <= 10)",
          "maxLength": 10
        },
        "mainImage": {
          "type": "string",
          "description": "Primary image URL or local asset path",
          "minLength": 1,
          "maxLength": 500
        },
        "additionalImages": {
          "type": "array",
          "description": "Optional additional product images (bounded <= 6)",
          "maxLength": 6
        },
        "allowedUnits": {
          "type": "array",
          "description": "Sensible quantity units supported for quotations (bounded <= 6)",
          "maxLength": 6
        },
        "published": {
          "type": "boolean",
          "description": "Whether the product is active and visible in the public catalogue"
        },
        "displayOrder": {
          "type": "number",
          "description": "Numeric sort order in the catalogue"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp"
        }
      },
      "required": [
        "id",
        "name",
        "slug",
        "category",
        "shortDescription",
        "fullDescription",
        "commonApplications",
        "mainImage",
        "additionalImages",
        "allowedUnits",
        "published",
        "displayOrder",
        "createdAt",
        "updatedAt"
      ]
    },
    "QuoteRequest": {
      "title": "QuoteRequest",
      "description": "Private customer quotation request record.",
      "type": "object",
      "properties": {
        "quoteReference": {
          "type": "string",
          "description": "Unique backend-validated quotation reference code",
          "minLength": 6,
          "maxLength": 40,
          "pattern": "^NM-Q-[0-9]{8}-[A-Z0-9]{6}$"
        },
        "customerName": {
          "type": "string",
          "description": "Full name of the customer",
          "minLength": 2,
          "maxLength": 100
        },
        "companyName": {
          "type": "string",
          "description": "Optional company or organization name",
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "description": "Customer phone number",
          "minLength": 8,
          "maxLength": 25,
          "pattern": "^[0-9+\\-\\s()]{8,25}$"
        },
        "email": {
          "type": "string",
          "description": "Customer email address",
          "minLength": 5,
          "maxLength": 120,
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
        },
        "productSlug": {
          "type": "string",
          "description": "Selected product slug",
          "minLength": 2,
          "maxLength": 80,
          "pattern": "^[a-z0-9\\-]+$"
        },
        "productName": {
          "type": "string",
          "description": "Historical snapshot of selected product name at time of quote",
          "minLength": 2,
          "maxLength": 100
        },
        "quantity": {
          "type": "string",
          "description": "Required quantity value",
          "minLength": 1,
          "maxLength": 40
        },
        "quantityUnit": {
          "type": "string",
          "description": "Selected quantity unit (e.g. Tonnes, kg, Bags, Packets)",
          "minLength": 1,
          "maxLength": 30
        },
        "deliveryLocation": {
          "type": "string",
          "description": "City, district or delivery destination",
          "minLength": 2,
          "maxLength": 200
        },
        "message": {
          "type": "string",
          "description": "Special requirements or enquiry notes",
          "maxLength": 1500
        },
        "privacyConsent": {
          "type": "boolean",
          "description": "Customer explicit consent to process enquiry details"
        },
        "status": {
          "type": "string",
          "description": "Current workflow status of the quotation request",
          "enum": ["New", "Under Review", "Contacted", "Quotation Prepared", "Closed"],
          "maxLength": 30
        },
        "internalNotes": {
          "type": "string",
          "description": "Administrator internal notes and follow-up records",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Submission server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last status/note update server timestamp"
        }
      },
      "required": [
        "quoteReference",
        "customerName",
        "companyName",
        "phone",
        "email",
        "productSlug",
        "productName",
        "quantity",
        "quantityUnit",
        "deliveryLocation",
        "message",
        "privacyConsent",
        "status",
        "internalNotes",
        "createdAt",
        "updatedAt"
      ]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Private customer general contact enquiry record.",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "Customer full name",
          "minLength": 2,
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "description": "Customer phone number",
          "minLength": 8,
          "maxLength": 25,
          "pattern": "^[0-9+\\-\\s()]{8,25}$"
        },
        "email": {
          "type": "string",
          "description": "Optional customer email address",
          "maxLength": 120
        },
        "subject": {
          "type": "string",
          "description": "Enquiry subject or category",
          "minLength": 2,
          "maxLength": 140
        },
        "message": {
          "type": "string",
          "description": "Customer enquiry message body",
          "minLength": 5,
          "maxLength": 1500
        },
        "privacyConsent": {
          "type": "boolean",
          "description": "Customer explicit consent to store contact submission"
        },
        "status": {
          "type": "string",
          "description": "Review status of the contact message",
          "enum": ["New", "Reviewed", "Responded", "Archived"],
          "maxLength": 30
        },
        "internalNotes": {
          "type": "string",
          "description": "Administrator internal follow-up notes",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Submission server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp"
        }
      },
      "required": [
        "fullName",
        "phone",
        "email",
        "subject",
        "message",
        "privacyConsent",
        "status",
        "internalNotes",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Protected administrator authorization registry record.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "Verified administrator email address",
          "minLength": 5,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "description": "Administrator role designation",
          "enum": ["admin"],
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp"
        }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit log of important administrator actions with sensitive data excluded.",
      "type": "object",
      "properties": {
        "adminUid": {
          "type": "string",
          "description": "Administrator UID",
          "minLength": 1,
          "maxLength": 128
        },
        "adminEmail": {
          "type": "string",
          "description": "Administrator email",
          "minLength": 3,
          "maxLength": 120
        },
        "action": {
          "type": "string",
          "description": "Short action code (e.g. UPDATE_PRODUCT, UPDATE_QUOTE_STATUS)",
          "minLength": 2,
          "maxLength": 80
        },
        "targetId": {
          "type": "string",
          "description": "Identifier of target record",
          "minLength": 1,
          "maxLength": 128
        },
        "summary": {
          "type": "string",
          "description": "Non-sensitive summary of the administrative change",
          "minLength": 2,
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Action server timestamp"
        }
      },
      "required": ["adminUid", "adminEmail", "action", "targetId", "summary", "createdAt"]
    }
  },
  "firestore": {
    "/business_settings/{settingId}": {
      "schema": { "$ref": "#/entities/BusinessSettings" },
      "description": "Public business settings and contact configuration (document ID: main)"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Mineral product catalogue records"
    },
    "/quote_requests/{quoteId}": {
      "schema": { "$ref": "#/entities/QuoteRequest" },
      "description": "Customer quotation requests (private to authorized administrators)"
    },
    "/contact_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Customer contact form messages (private to authorized administrators)"
    },
    "/admin_users/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Protected administrator registry"
    },
    "/activity_logs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Administrator operational activity logs"
    }
  }
}
